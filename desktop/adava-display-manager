#!/bin/sh
set -eu

display=:0
while :; do
  Xorg "$display" vt7 -nolisten tcp &
  xorg_pid=$!
  trap 'kill "$xorg_pid" 2>/dev/null || true; exit 0' HUP INT TERM
  until DISPLAY="$display" xdpyinfo >/dev/null 2>&1; do
    kill -0 "$xorg_pid" 2>/dev/null || exit 1
    sleep 1
  done
  DISPLAY="$display" /usr/bin/adava-greeter || true
  kill "$xorg_pid" 2>/dev/null || true
  wait "$xorg_pid" 2>/dev/null || true
done
