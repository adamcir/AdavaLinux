#!/bin/sh
set -eu

usage() {
    echo "Usage: man [section] <page>" >&2
    exit 1
}

[ "$#" -ge 1 ] || usage
section=""
if [ "$#" -ge 2 ]; then
    case "$1" in
        1|2|3|4|5|6|7|8|9) section="$1"; shift ;;
    esac
fi
page="$1"
case "$page" in *[!A-Za-z0-9_.+-]*|"") echo "man: invalid page name: $page" >&2; exit 1 ;; esac

if [ -n "$section" ]; then sections="$section"; else sections="1 2 3 4 5 6 7 8 9"; fi
file=""
for sec in $sections; do
    for candidate in "/usr/share/man/man$sec/$page.$sec" "/usr/local/share/man/man$sec/$page.$sec"; do
        if [ -f "$candidate" ]; then file="$candidate"; break 2; fi
        if [ -f "$candidate.gz" ]; then file="$candidate.gz"; break 2; fi
    done
done
[ -n "$file" ] || { echo "No manual entry for $page" >&2; exit 1; }

render() {
    sed -e '/^\.\\"/d' \
        -e 's/^\.TH .*//' \
        -e 's/^\.SH[[:space:]]*/\n/' \
        -e 's/^\.SS[[:space:]]*/  /' \
        -e 's/^\.TP[[:space:]]*$//' \
        -e 's/^\.PP[[:space:]]*$//' \
        -e 's/^\.P[[:space:]]*$//' \
        -e 's/^\.B[[:space:]]*//' \
        -e 's/^\.I[[:space:]]*//' \
        -e 's/\\f[BRIP]//g' \
        -e 's/\\fP//g' \
        -e 's/\\-/-/g'
}

case "$file" in
    *.gz) gzip -dc "$file" | render ;;
    *) cat "$file" | render ;;
esac
