#!/bin/sh

case "$1" in
  deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ip link set "$interface" up 2>/dev/null
    ;;
  renew|bound)
    ip addr flush dev "$interface" 2>/dev/null
    ip addr add "$ip/$mask" dev "$interface"
    ip link set "$interface" up 2>/dev/null
    if [ -n "$router" ]; then
      ip route add default via "$router" dev "$interface" 2>/dev/null || \
      ip route replace default via "$router" dev "$interface"
    fi
    mkdir -p /etc
    : > /etc/resolv.conf

    # QEMU user-mode networking advertises gateway 10.0.2.2 and provides its
    # DNS proxy at 10.0.2.3.  Put it first because it follows the host resolver.
    case " $router " in
      *" 10.0.2.2 "*)
        echo "nameserver 10.0.2.3" >> /etc/resolv.conf
        ;;
    esac

    for d in $dns; do
      [ -n "$d" ] || continue
      grep -qx "nameserver $d" /etc/resolv.conf 2>/dev/null ||         echo "nameserver $d" >> /etc/resolv.conf
    done

    # If DHCP supplied no DNS server, many home routers also proxy DNS.
    if ! grep -q '^nameserver ' /etc/resolv.conf 2>/dev/null && [ -n "$router" ]; then
      for r in $router; do
        echo "nameserver $r" >> /etc/resolv.conf
        break
      done
    fi

    # Last-resort fallbacks.  They are only reached if DHCP/QEMU did not
    # provide a resolver at all.
    if ! grep -q '^nameserver ' /etc/resolv.conf 2>/dev/null; then
      echo "nameserver 1.1.1.1" >> /etc/resolv.conf
      echo "nameserver 8.8.8.8" >> /etc/resolv.conf
    fi

    echo "options timeout:2 attempts:2 rotate" >> /etc/resolv.conf
    ;;
esac

exit 0
